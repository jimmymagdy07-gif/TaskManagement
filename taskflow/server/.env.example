# Server environment — copy to ../.env (project root) or server/.env
# The app loads .env from the taskflow root first, then server/.env

NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/taskflow
DB_SSL=false
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
