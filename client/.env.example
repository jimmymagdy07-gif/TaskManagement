# Client environment — copy to client/.env (never commit .env)
# Vite only exposes variables prefixed with VITE_

# Guest demo login (must match seeded user in server/db/schema.sql after db:init)
VITE_GUEST_EMAIL=alex@taskflow.dev
VITE_GUEST_PASSWORD=your_demo_password_here

# Optional: backend URL for Vite dev proxy
VITE_API_PROXY_TARGET=http://localhost:5000
