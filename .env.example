# =============================================================================
# TaskFlow — copy to .env in this folder (never commit .env)
# =============================================================================

# --- Server (Node / Express) ---
NODE_ENV=development
PORT=5000

# PostgreSQL connection string (use your local user/password)
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/taskflow
DB_SSL=false

# Auth — use a long random string (e.g. openssl rand -base64 48)
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Frontend origin for CORS (must match Vite dev URL)
CLIENT_URL=http://localhost:3000

# --- Client (Vite — copy these to client/.env as well) ---
# Public demo guest login (matches seeded user after npm run db:init)
VITE_GUEST_EMAIL=alex@taskflow.dev
VITE_GUEST_PASSWORD=your_demo_password_here

# Optional: API proxy target for Vite dev server
VITE_API_PROXY_TARGET=http://localhost:5000
